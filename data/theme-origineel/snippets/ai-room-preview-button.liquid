  <script>
    (function () {
      const root = document.getElementById("{{ ai_preview_id }}");

      if (!root) return;

const endpoint = root.dataset.endpoint;
const baseProductTitle = root.dataset.productTitle || "dit product";
const fallbackProductImage = root.dataset.productImage || "";

let productTitle = baseProductTitle;
let productImageUrl = fallbackProductImage
  ? new URL(fallbackProductImage, window.location.origin).href
  : "";

const variantDataElement = root.querySelector("[data-ai-variant-json]");
let aiVariants = [];

try {
  aiVariants = JSON.parse(variantDataElement ? variantDataElement.textContent : "[]");
} catch (error) {
  console.warn("AI variant data kon niet worden gelezen:", error);
  aiVariants = [];
}

function getCurrentVariantId() {
  const productInfo = root.closest("product-info") || document;

  const activeInput =
    productInfo.querySelector('form[action*="/cart/add"] input[name="id"]:not([disabled])') ||
    productInfo.querySelector('input[name="id"]:not([disabled])') ||
    productInfo.querySelector('select[name="id"]');

  if (activeInput && activeInput.value) {
    return String(activeInput.value);
  }

  const url = new URL(window.location.href);
  return url.searchParams.get("variant");
}

function updateAiProductFromSelectedVariant() {
  const currentVariantId = getCurrentVariantId();

  const matchedVariant = aiVariants.find(function (variant) {
    return String(variant.id) === String(currentVariantId);
  });

  const variantImage = matchedVariant && matchedVariant.image
    ? matchedVariant.image
    : fallbackProductImage;

  productImageUrl = variantImage
    ? new URL(variantImage, window.location.origin).href
    : "";

  const variantTitle =
    matchedVariant &&
    matchedVariant.title &&
    matchedVariant.title !== "Default Title"
      ? matchedVariant.title
      : "";

  const skuText =
    matchedVariant && matchedVariant.sku
      ? " - SKU " + matchedVariant.sku
      : "";

  productTitle = variantTitle
    ? baseProductTitle + " - " + variantTitle + skuText
    : baseProductTitle + skuText;
}

updateAiProductFromSelectedVariant();

document.addEventListener(
  "change",
  function () {
    setTimeout(updateAiProductFromSelectedVariant, 100);
  },
  true
);

document.addEventListener("variant:change", function () {
  setTimeout(updateAiProductFromSelectedVariant, 100);
});

document.addEventListener("variant-change", function () {
  setTimeout(updateAiProductFromSelectedVariant, 100);
});
      const openButton = root.querySelector("[data-ai-open]");
      const closeButton = root.querySelector("[data-ai-close]");
      const overlay = root.querySelector("[data-ai-overlay]");
      const fileInput = root.querySelector("[data-ai-file]");
      const generateButton = root.querySelector("[data-ai-generate]");
      const statusEl = root.querySelector("[data-ai-status]");
      const uploadPreviewBox = root.querySelector("[data-ai-upload-preview-box]");
      const uploadPreview = root.querySelector("[data-ai-upload-preview]");
      const resultWrap = root.querySelector("[data-ai-result-wrap]");
      const resultImage = root.querySelector("[data-ai-result]");
      const downloadLink = root.querySelector("[data-ai-download]");

      let selectedFile = null;
      let resizedFile = null;

      function setStatus(message) {
        statusEl.textContent = message || "";
      }

function openModal() {
  if (overlay.parentElement !== document.body) {
    document.body.appendChild(overlay);
  }

  overlay.hidden = false;
  document.documentElement.style.overflow = "hidden";
  document.body.style.overflow = "hidden";
  document.body.classList.add("ai-room-preview-modal-open");
}

function closeModal() {
  overlay.hidden = true;
  document.documentElement.style.overflow = "";
  document.body.style.overflow = "";
  document.body.classList.remove("ai-room-preview-modal-open");
}

      function fileToImage(file) {
        return new Promise(function (resolve, reject) {
          const img = new Image();
          const url = URL.createObjectURL(file);

          img.onload = function () {
            URL.revokeObjectURL(url);
            resolve(img);
          };

          img.onerror = function () {
            URL.revokeObjectURL(url);
            reject(new Error("De afbeelding kon niet worden gelezen."));
          };

          img.src = url;
        });
      }

      async function resizeImageToMax1200(file) {
        const img = await fileToImage(file);
        const maxSize = 1200;

        let width = img.naturalWidth;
        let height = img.naturalHeight;

        if (width > height && width > maxSize) {
          height = Math.round((height * maxSize) / width);
          width = maxSize;
        } else if (height >= width && height > maxSize) {
          width = Math.round((width * maxSize) / height);
          height = maxSize;
        }

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;

        const context = canvas.getContext("2d");
        context.drawImage(img, 0, 0, width, height);

        return new Promise(function (resolve) {
          canvas.toBlob(
            function (blob) {
              if (!blob) {
                resolve(file);
                return;
              }

              const resized = new File(
                [blob],
                "kamerfoto-1200px.jpg",
                {
                  type: "image/jpeg",
                  lastModified: Date.now()
                }
              );

              resolve(resized);
            },
            "image/jpeg",
            0.92
          );
        });
      }

openButton.addEventListener("click", function () {
  updateAiProductFromSelectedVariant();

  if (!endpoint) {
          alert("De AI endpoint URL ontbreekt. Vul deze in bij de blokinstellingen.");
          return;
        }

        if (!productImageUrl) {
          alert("Er is geen productafbeelding gevonden voor dit product.");
          return;
        }

        openModal();
      });

      closeButton.addEventListener("click", closeModal);

      overlay.addEventListener("click", function (event) {
        if (event.target === overlay) {
          closeModal();
        }
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && !overlay.hidden) {
          closeModal();
        }
      });

      fileInput.addEventListener("change", async function () {
        selectedFile = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        resizedFile = null;
        resultWrap.hidden = true;
        resultImage.src = "";
        downloadLink.href = "#";

        if (!selectedFile) {
          generateButton.disabled = true;
          uploadPreviewBox.hidden = true;
          setStatus("");
          return;
        }

        if (!selectedFile.type.startsWith("image/")) {
          generateButton.disabled = true;
          uploadPreviewBox.hidden = true;
          setStatus("Upload een geldig afbeeldingsbestand.");
          return;
        }

        setStatus("Afbeelding wordt voorbereid...");

        try {
          resizedFile = await resizeImageToMax1200(selectedFile);

          const previewUrl = URL.createObjectURL(resizedFile);
          uploadPreview.src = previewUrl;
          uploadPreviewBox.hidden = false;

          generateButton.disabled = false;
          setStatus("Klaar om te genereren.");
        } catch (error) {
          console.error(error);
          generateButton.disabled = true;
          setStatus("De afbeelding kon niet worden verwerkt. Probeer een andere foto.");
        }
      });

      generateButton.addEventListener("click", async function () {
      updateAiProductFromSelectedVariant();

      if (!resizedFile) {
          setStatus("Upload eerst een kamerfoto.");
          return;
        }

        generateButton.disabled = true;
        setStatus("AI-preview wordt gemaakt. Dit kan even duren...");
        resultWrap.hidden = true;

        try {
          const formData = new FormData();
          formData.append("roomImage", resizedFile);
          formData.append("productImageUrl", productImageUrl);
          formData.append("productTitle", productTitle);

          const response = await fetch(endpoint, {
            method: "POST",
            body: formData
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || "Genereren mislukt.");
          }

          if (!data.image) {
            throw new Error("Er is geen afbeelding teruggekomen.");
          }

          resultImage.src = data.image;
          downloadLink.href = data.image;
          resultWrap.hidden = false;
          setStatus("Klaar! Bekijk je AI-preview.");
        } catch (error) {
          console.error(error);
          setStatus(error.message || "Er ging iets mis. Probeer het opnieuw.");
        } finally {
          generateButton.disabled = false;
        }
      });
    })();
  </script>
{% endif %}
