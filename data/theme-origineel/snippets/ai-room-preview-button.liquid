{% comment %}
  AI Room Preview Button Snippet
  Wordt gebruikt als block binnen de Product information section.
{% endcomment %}

{% if product and block %}
  {% assign ai_preview_id = 'ai-room-preview-' | append: section.id | append: '-' | append: block.id %}

<div
  id="{{ ai_preview_id }}"
  class="ai-room-preview"
  data-endpoint="{{ block.settings.api_endpoint }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-ai-variant-json>
    [
      {% for variant in product.variants %}
        {% assign ai_variant_image = variant.featured_image | default: product.featured_image %}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "sku": {{ variant.sku | json }},
          "image": {% if ai_variant_image %}{{ ai_variant_image | image_url: width: 1200 | json }}{% else %}""{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
    <button type="button" class="ai-room-preview__button" data-ai-open>
      {{ block.settings.button_text }}
    </button>

    <div class="ai-room-preview__overlay" data-ai-overlay hidden>
      <div class="ai-room-preview__modal" role="dialog" aria-modal="true" aria-labelledby="{{ ai_preview_id }}-title">
        <button type="button" class="ai-room-preview__close" aria-label="Sluiten" data-ai-close>
          ×
        </button>

        <div class="ai-room-preview__header">
          <h2 id="{{ ai_preview_id }}-title">
            {{ block.settings.popup_title }}
          </h2>
          <p>
            {{ block.settings.popup_text }}
          </p>
        </div>

        <div class="ai-room-preview__content">
          <div class="ai-room-preview__upload">
            <label class="ai-room-preview__label" for="{{ ai_preview_id }}-file">
              Upload een foto van je kamer
            </label>

            <input
              id="{{ ai_preview_id }}-file"
              class="ai-room-preview__file"
              type="file"
              accept="image/png,image/jpeg,image/webp"
              data-ai-file
            >

            <div class="ai-room-preview__preview-box" data-ai-upload-preview-box hidden>
            <img data-ai-upload-preview alt="Geüploade kamerfoto" width="1200" height="1200" loading="lazy">
            </div>

            <button type="button" class="ai-room-preview__generate" data-ai-generate disabled>
              {{ block.settings.generate_button_text }}
            </button>

            <p class="ai-room-preview__status" data-ai-status></p>
          </div>

          <div class="ai-room-preview__result" data-ai-result-wrap hidden>
            <h3>Jouw AI-preview</h3>
           <img data-ai-result alt="AI productvisualisatie" width="1024" height="1024" loading="lazy">
            <a class="ai-room-preview__download" href="#" download="ai-product-preview.png" data-ai-download>
              Download afbeelding
            </a>
          </div>
        </div>

        <p class="ai-room-preview__disclaimer">
          {{ block.settings.disclaimer_text }}
        </p>
      </div>
    </div>
  </div>

  <style>
    #{{ ai_preview_id }} {
      margin: 20px 0;
    }

    #{{ ai_preview_id }} .ai-room-preview__button,
    #{{ ai_preview_id }} .ai-room-preview__generate,
    #{{ ai_preview_id }} .ai-room-preview__download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 12px 18px;
      border: 0;
      border-radius: 999px;
      background: #111111;
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      line-height: 1;
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #{{ ai_preview_id }} .ai-room-preview__button:hover,
    #{{ ai_preview_id }} .ai-room-preview__generate:hover,
    #{{ ai_preview_id }} .ai-room-preview__download:hover {
      opacity: 0.86;
      transform: translateY(-1px);
    }

    #{{ ai_preview_id }} .ai-room-preview__generate:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    #{{ ai_preview_id }} .ai-room-preview__overlay {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(0, 0, 0, 0.62);
    }

    #{{ ai_preview_id }} .ai-room-preview__overlay[hidden] {
      display: none;
    }

    #{{ ai_preview_id }} .ai-room-preview__modal {
      position: relative;
      width: min(960px, 100%);
      max-height: 92vh;
      overflow: auto;
      border-radius: 22px;
      background: #ffffff;
      color: #111111;
      padding: 28px;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
    }

    #{{ ai_preview_id }} .ai-room-preview__close {
      position: absolute;
      top: 14px;
      right: 16px;
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 50%;
      background: #f2f2f2;
      color: #111111;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
    }

    #{{ ai_preview_id }} .ai-room-preview__header {
      padding-right: 44px;
      margin-bottom: 22px;
    }

    #{{ ai_preview_id }} .ai-room-preview__header h2 {
      margin: 0 0 8px;
      font-size: 28px;
      line-height: 1.15;
    }

    #{{ ai_preview_id }} .ai-room-preview__header p {
      margin: 0;
      color: #555555;
      font-size: 15px;
      line-height: 1.5;
    }

    #{{ ai_preview_id }} .ai-room-preview__content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    #{{ ai_preview_id }} .ai-room-preview__upload,
    #{{ ai_preview_id }} .ai-room-preview__result {
      border: 1px solid #eeeeee;
      border-radius: 18px;
      padding: 18px;
      background: #fafafa;
    }

    #{{ ai_preview_id }} .ai-room-preview__label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    #{{ ai_preview_id }} .ai-room-preview__file {
      width: 100%;
      padding: 12px;
      border: 1px dashed #cccccc;
      border-radius: 14px;
      background: #ffffff;
    }

    #{{ ai_preview_id }} .ai-room-preview__preview-box {
      margin: 16px 0;
      overflow: hidden;
      border-radius: 16px;
      background: #ffffff;
    }

    #{{ ai_preview_id }} img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 16px;
    }

    #{{ ai_preview_id }} .ai-room-preview__status {
      margin: 14px 0 0;
      color: #555555;
      font-size: 14px;
      line-height: 1.4;
    }

    #{{ ai_preview_id }} .ai-room-preview__result h3 {
      margin: 0 0 12px;
      font-size: 20px;
    }

    #{{ ai_preview_id }} .ai-room-preview__download {
      margin-top: 14px;
    }

    #{{ ai_preview_id }} .ai-room-preview__disclaimer {
      margin: 18px 0 0;
      color: #777777;
      font-size: 12px;
      line-height: 1.45;
    }

    @media screen and (max-width: 749px) {
      #{{ ai_preview_id }} .ai-room-preview__modal {
        padding: 22px;
      }

      #{{ ai_preview_id }} .ai-room-preview__content {
        grid-template-columns: 1fr;
      }

      #{{ ai_preview_id }} .ai-room-preview__header h2 {
        font-size: 23px;
      }
    }
    body.ai-room-preview-modal-open {
  overflow: hidden !important;
}

